# ===================================================
# Cybersecurity AI Agent - Configuration
# ===================================================

# Anthropic API Key (Required)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: VirusTotal API Key for threat intelligence
VIRUSTOTAL_API_KEY=your-virustotal-api-key-here

# Optional: Shodan API Key for internet-wide scanning
SHODAN_API_KEY=your-shodan-api-key-here

# Optional: AbuseIPDB API Key for IP reputation
ABUSEIPDB_API_KEY=your-abuseipdb-api-key-here

# Agent Configuration
AGENT_MODEL=claude-sonnet-4-20250514
AGENT_MAX_TOKENS=4096
AGENT_TEMPERATURE=0.1

# ===================================================
# API Server
# ===================================================
# Local only: 127.0.0.1 | Remote access: 0.0.0.0
API_HOST=127.0.0.1
API_PORT=8000

# ===================================================
# Security
# ===================================================
# API key for authentication (auto-generated if empty)
API_KEY=

# Rate limiting (requests per minute per IP)
RATE_LIMIT_RPM=30

# Brute-force lockout
AUTH_LOCKOUT_ATTEMPTS=10
AUTH_LOCKOUT_MINUTES=15

# IP Allowlist (comma-separated, empty = allow all authenticated)
# Example: IP_ALLOWLIST=192.168.1.10,10.0.0.5,203.0.113.50
IP_ALLOWLIST=

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ===================================================
# TLS / HTTPS (for remote deployment)
# ===================================================
SSL_ENABLED=false
SSL_CERTFILE=certs/server.crt
SSL_KEYFILE=certs/server.key

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Audit log file path
AUDIT_LOG_FILE=audit.log
